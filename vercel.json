{
  "ignoreCommand": "if [ \"$VERCEL_ENV\" = \"preview\" ]; then exit 1; else exit 0; fi",
  "functions": {
    "api/lookup.js": {
      "maxDuration": 25
    },
    "api/import.js": {
      "maxDuration": 60
    }
  },
  "framework": null,
  "buildCommand": "node build-preview.cjs",
  "installCommand": "",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/portal.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
